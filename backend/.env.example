PORT=3000
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kinetic
# Set to "true" when connecting over the public internet (e.g. Render External URL)
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me
JWT_EXPIRES_IN=12h
